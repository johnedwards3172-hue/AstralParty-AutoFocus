<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AstralPartyAutoFocus</AssemblyName>
    <RootNamespace>AstralParty.AutoFocus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.4.0</Version>
    <Product>Astral Party AutoFocus</Product>
    <Description>星引擎 Astral Party（吉星派对）窗口前置插件：轮到你操作时自动把游戏窗口抢到前台</Description>
    <NoWarn>CS0436;CS0108</NoWarn>

    <!-- 不把本机源码路径写进 DLL -->
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    只需要 BepInEx 6 (IL2CPP) 的 BepInEx\core 目录里的 4 个 DLL。
    本项目不引用 UnityEngine / Il2Cppmscorlib，因此不需要游戏生成的 interop 文件。

    指定方式，优先级从高到低：
      1. dotnet build -c Release -p:BepInExDir="...\BepInEx\core"
      2. 把 DLL 放到仓库的 lib/BepInEx/core/
      3. 直接改下面的默认值
  -->
  <PropertyGroup>
    <BepInExDir Condition="'$(BepInExDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\lib\BepInEx\core')">$(MSBuildThisFileDirectory)..\lib\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <Target Name="CheckBepInEx" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.Core.dll')"
           Text="找不到 BepInEx.Core.dll。请用 -p:BepInExDir=&quot;...\BepInEx\core&quot; 指定 BepInEx 6 (IL2CPP) 的 core 目录，或把 DLL 放到 lib\BepInEx\core\。所需文件：BepInEx.Core.dll、BepInEx.Unity.IL2CPP.dll、Il2CppInterop.Runtime.dll、0Harmony.dll" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>